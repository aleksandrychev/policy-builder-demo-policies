# Generated by CFEngine Policy Builder from "Webserver".
# Edits here are overwritten when the project is saved.
body file control
{
  evaluation_order => "top_down";
}

bundle common webserver_vars
{
  vars:
    # Define Variable
    "test" string => "pook";
}

bundle agent webserver
{
  # Install web server package
  packages:
    "$(common_vars.webserver_package)"
      policy => "present",
      if => "webserver_role",
      classes => results("bundle", "webserver_install_web_server_package");

  # Render nginx config
  vars:
    "render_nginx_config_worker_processes"
      string => "$(common_vars.worker_processes)";

    "render_nginx_config_worker_connections"
      string => "$(common_vars.worker_connections)";

    "render_nginx_config_template_data"
      data => mergedata(
        '{ "vars": { "common_vars": { "worker_processes": render_nginx_config_worker_processes, "worker_connections": render_nginx_config_worker_connections } } }'
      );

  files:
    "/etc/nginx/nginx.conf"
      create => "true",
      edit_template => "$(this.promise_dirname)/templates/webserver_render_nginx_config.mustache",
      template_method => "mustache",
      perms => mog("644", "root", "root"),
      template_data => @(render_nginx_config_template_data),
      if => "webserver_install_web_server_package_kept|webserver_install_web_server_package_repaired",
      classes => results("bundle", "webserver_render_nginx_config");

  # Publish the demo landing page
  vars:
    "publish_the_demo_landing_page_fqhost" string => "$(sys.fqhost)";
    "publish_the_demo_landing_page_flavor" string => "$(sys.flavor)";

    "publish_the_demo_landing_page_worker_processes"
      string => "$(common_vars.worker_processes)";

    "publish_the_demo_landing_page_cf_version" string => "$(sys.cf_version)";

    "publish_the_demo_landing_page_template_data"
      data => mergedata(
        '{ "vars": { "sys": { "fqhost": publish_the_demo_landing_page_fqhost, "flavor": publish_the_demo_landing_page_flavor, "cf_version": publish_the_demo_landing_page_cf_version }, "common_vars": { "worker_processes": publish_the_demo_landing_page_worker_processes } } }',
        parsejson(
          format(
            '{ "classes": { "webserver_role": %s } }',
            ifelse("webserver_role", "true", "false")
          )
        )
      );

  files:
    "/var/www/html/index.html"
      create => "true",
      edit_template => "$(this.promise_dirname)/templates/webserver_publish_the_demo_landing_page.mustache",
      template_method => "mustache",
      perms => mog("644", "root", "root"),
      template_data => @(publish_the_demo_landing_page_template_data),
      if => "webserver_install_web_server_package_kept|webserver_install_web_server_package_repaired";

  # Keep nginx running
  services:
    "nginx"
      service_policy => "start",
      if => "webserver_install_web_server_package_kept|webserver_install_web_server_package_repaired";

  # Restart nginx on config change
  services:
    "nginx"
      service_policy => "restart",
      if => "webserver_render_nginx_config_repaired";

  # Remove conflicting Apache
  packages:
    "apache2"
      policy => "absent",
      if => "webserver_role";

  # Remove default nginx site
  files:
    "/etc/nginx/sites-enabled/default"
      delete => tidy,
      pathtype => "literal";

  # Lock down nginx config files
  vars:
    "lock_down_nginx_config_files_path"
      slist => { "/etc/nginx/nginx.conf", "/etc/nginx/conf.d/default.conf" };

  files:
    "$(lock_down_nginx_config_files_path)"
      perms => mog_dirs("644", "root", "root");

  # Create deploy user
  users:
    "deploy" policy => "present";

  # Report provisioning done
  reports:
    "Web server provisioning complete";
}

body perms mog_dirs(mode, user, group)
{
  owners => { "$(user)" };
  groups => { "$(group)" };
  mode => "$(mode)";
  rxdirs => "true";
}
