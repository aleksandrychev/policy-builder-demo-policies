# Generated by CFEngine Policy Builder from "Common".
# Edits here are overwritten when the project is saved.
bundle common common_vars
{
  vars:
    # Nginx settings
    "webserver_package" string => "nginx";

    # The lines of /proc/cpuinfo
    # → keep entries matching processor.*
    # → count the entries
    # → fall back to "auto" if unset or "0"
    "worker_processes__in"
      int => length(
        grep(
          "processor.*",
          readstringlist("/proc/cpuinfo", "", "\n", "1000", "1048576")
        )
      );

    "worker_processes"
      string => "$(common_vars.worker_processes__in)",
      if => and(
        isvariable("common_vars.worker_processes__in"),
        not(strcmp("$(common_vars.worker_processes__in)", "0"))
      );

    "worker_processes"
      string => "auto",
      if => not(isvariable("common_vars.worker_processes"));

    "worker_connections" string => "1024";

  classes:
    # Web server role
    "webserver_role" expression => "any";
}
