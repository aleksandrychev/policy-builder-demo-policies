# Generated by CFEngine Policy Builder from "Security".
# Edits here are overwritten when the project is saved.
body file control
{
  evaluation_order => "top_down";
}

bundle common security_vars
{
  classes:
    # SSH server present
    "sshd_installed" expression => fileexists("/etc/ssh/sshd_config");
}

bundle agent security
{
  # Group: SSH hardening
  methods:
    "SSH hardening" usebundle => security_ssh_hardening;

  # Group: Account protection
  methods:
    "Account protection" usebundle => security_account_protection;

  # Login banner
  files:
    "/etc/issue"
      create => "true",
      edit_line => append_if_no_lines(
        "Authorized access only. Activity may be monitored."
      );
}

# Group "SSH hardening", run as one step of security.
bundle agent security_ssh_hardening
{
  # Harden SSH
  vars:
    "harden_ssh_settings[PermitRootLogin]" string => "no";
    "harden_ssh_settings[MaxAuthTries]" string => "3";
    "harden_ssh_settings[X11Forwarding]" string => "no";

  files:
    "/etc/ssh/sshd_config"
      edit_line => set_line_based(
        "security_ssh_hardening.harden_ssh_settings",
        " ",
        "\s+",
        ".*",
        "\s*#\s*"
      ),
      if => "sshd_installed",
      classes => results("bundle", "security_harden_ssh");

  # Restart SSH on config change
  services:
    "ssh"
      service_policy => "restart",
      if => "security_harden_ssh_repaired";
}

# Group "Account protection", run as one step of security.
bundle agent security_account_protection
{
  # Lock down account files
  vars:
    "lock_down_account_files_path" slist => { "/etc/passwd", "/etc/group" };

  files:
    "$(lock_down_account_files_path)" perms => mog_dirs("644", "root", "root");

  # Protect password hashes
  files:
    "/etc/shadow" perms => mog_dirs("640", "root", "shadow");

  # Watch account files
  vars:
    "watch_account_files_path"
      slist => { "/etc/passwd", "/etc/group", "/etc/shadow" };

  files:
    "$(watch_account_files_path)"
      changes => detect_content,
      classes => results("bundle", "security_watch_account_files");

  # Report account changes
  reports:
    "Local accounts changed on $(sys.fqhost)"
      if => "security_watch_account_files_repaired";
}
