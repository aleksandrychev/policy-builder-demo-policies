            },
            {
              "valueSourceId": "literal",
              "params": {
                "variable_name": "worker_connections",
                "value": "1024"
              },
              "id": "dd1adad5-609f-4f3c-8d6c-9b77131cfbe4"
            }
          ],
          "instanceId": "e842343c-0e9a-4b06-93a9-cbdc18456b8a"
        },
