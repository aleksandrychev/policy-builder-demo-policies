    {
      "id": "76fbc879-b2c2-46ce-a2ef-34714164afa6",
      "name": "Webserver",
      "bundle": "webserver",
      "path": "./webserver.cf",
      "description": "Turns a webserver_role host into an nginx web server. It installs nginx, removes a conflicting Apache, renders nginx.conf from a template and restarts nginx only when that file changes. It keeps the service running and publishes a landing page. It also tidies up: removes the default site, locks down config permissions, prunes old logs and creates a deploy user.",
      "blocks": [
        {
          "blockId": "install-package",
          "label": "Install web server package",
          "params": {
            "package_name": "$(common_vars.webserver_package)"
          },
          "condition": {
            "mode": "if",
            "kind": "class",
            "className": "webserver_role"
          },
          "instanceId": "07f54456-b95a-44b8-88f3-bb6f634d171a"
        },
        {
          "blockId": "remove-package",
          "label": "Remove conflicting Apache",
          "params": {
            "package_name": "apache2"
          },
          "condition": {
            "mode": "if",
            "kind": "class",
            "className": "webserver_role"
          },
          "instanceId": "4e549b72-8e78-4980-8e80-67eb5681dd79"
        },
        {
          "blockId": "render-template",
          "label": "Render nginx config",
          "params": {
            "destination": "/etc/nginx/nginx.conf",
            "template_content": "user www-data;\nworker_processes {{{vars.common_vars.worker_processes}}};\n\nevents {\n    worker_connections {{{vars.common_vars.worker_connections}}};\n}\n\nhttp {\n    include /etc/nginx/mime.types;\n    default_type application/octet-stream;\n\n    server {\n        listen 80;\n        server_name example.com;\n        root /var/www/html;\n    }\n}\n",
            "mode": "644",
            "owner": "root",
            "group": "root"
          },
          "instanceId": "003acbc7-ef89-43b0-86ea-3991c356398a"
        },
        {
          "blockId": "manage-service",
          "label": "Restart nginx on config change",
          "params": {
            "service_name": "nginx",
            "action": "restart"
          },
          "instanceId": "a2e88524-a5a6-4d7a-93d2-e8bcfd67e785"
        },
        {
          "blockId": "manage-service",
          "label": "Keep nginx running",
          "params": {
            "service_name": "nginx",
            "action": "start"
          },
          "instanceId": "6fe93a8f-cc78-4e94-a047-d67d339cd77a"
        },
        {
          "blockId": "create-directory",
          "label": "Create web root",
          "params": {
            "path": "/var/www/html",
            "mode": "755",
            "owner": "root",
            "group": "root"
          },
          "instanceId": "ee43fc82-4423-4955-8ff0-c8c574e553eb"
        },
        {
          "blockId": "render-template",
          "label": "Publish the demo landing page",
          "params": {
            "destination": "/var/www/html/index.html",
            "template_content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>CFEngine Policy Builder demo project</title>\n  <style>\n    :root { color-scheme: light dark; --accent: #0b7ad1; --ink: #1f2933; --muted: #5f6c7b; --card: #ffffff; --page: #eef2f7; }\n    @media (prefers-color-scheme: dark) { :root { --ink: #e6edf3; --muted: #9aa7b4; --card: #161b22; --page: #0d1117; } }\n    * { box-sizing: border-box; }\n    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px;\n           font: 16px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color: var(--ink); background: var(--page); }\n    main { width: min(640px, 100%); background: var(--card); border-radius: 16px; padding: 40px;\n           box-shadow: 0 12px 40px rgba(15, 23, 42, 0.12); border-top: 6px solid var(--accent); }\n    h1 { margin: 0 0 8px; font-size: 28px; }\n    p { margin: 0 0 24px; color: var(--muted); }\n    dl { display: grid; grid-template-columns: max-content 1fr; gap: 8px 24px; margin: 0; }\n    dt { color: var(--muted); }\n    dd { margin: 0; font-family: ui-monospace, \"SF Mono\", Menlo, monospace; }\n    .badge { display: inline-block; margin-bottom: 16px; padding: 2px 10px; border-radius: 999px;\n             background: var(--accent); color: #fff; font-size: 13px; font-weight: 600; }\n    footer { margin-top: 32px; font-size: 13px; color: var(--muted); }\n  </style>\n</head>\n<body>\n  <main>\n    {{#classes.webserver_role}}<span class=\"badge\">Web server role</span>{{/classes.webserver_role}}\n    <h1>CFEngine Policy Builder demo project</h1>\n    <p>This page, the nginx it runs on and everything around them were set up by policy built visually in CFEngine Policy Builder.</p>\n    <dl>\n      <dt>Host</dt><dd>{{{vars.sys.fqhost}}}</dd>\n      <dt>Operating system</dt><dd>{{{vars.sys.flavor}}}</dd>\n      <dt>nginx workers</dt><dd>{{{vars.common_vars.worker_processes}}}</dd>\n      <dt>CFEngine</dt><dd>{{{vars.sys.cf_version}}}</dd>\n    </dl>\n    <footer>Rendered by cf-agent from a Mustache template.</footer>\n  </main>\n</body>\n</html>\n",
            "mode": "644",
            "owner": "root",
            "group": "root"
          },
          "instanceId": "2d163568-dde7-4165-ae8e-db796426296f"
        },
        {
          "blockId": "remove-file",
          "label": "Remove default nginx site",
          "params": {
            "path": "/etc/nginx/sites-enabled/default"
          },
          "instanceId": "34da5d40-d7fc-4b82-b8e8-51ebe3d06e45"
        },
        {
          "blockId": "set-permissions",
          "label": "Lock down nginx config files",
          "params": {
            "path": "/etc/nginx/nginx.conf\n/etc/nginx/conf.d/default.conf",
            "mode": "644",
            "owner": "root",
            "group": "root"
          },
          "instanceId": "bc41f97f-76a2-421a-8036-38d6c25924f5"
        },
        {
          "blockId": "clean-up-old-files",
          "label": "Prune old nginx logs",
          "params": {
            "directory": "/var/log/nginx",
            "days": "30",
            "depth": "inf"
          },
          "instanceId": "1d466ec7-b72c-4540-8b4e-f83e49c89c43"
        },
        {
          "blockId": "manage-users",
          "label": "Create deploy user",
          "params": {
            "username": "deploy",
            "state": "present"
          },
          "instanceId": "4b8f4ef1-7acb-44c3-814c-92c908858b39"
        },
        {
          "blockId": "report-message",
          "label": "Report provisioning done",
          "params": {
            "message": "Web server provisioning complete"
          },
          "instanceId": "02938c84-c662-49ba-8cc7-493ac6d5edd3"
        }
