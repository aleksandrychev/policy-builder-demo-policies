    {
      "id": "bd719f43-4324-4375-95fa-4f8816a238e2",
      "name": "Security",
      "bundle": "security",
      "path": "./security.cf",
      "description": "Baseline hardening for every host. Where an SSH server is installed, it tightens sshd_config and restarts SSH when that changes. It enforces permissions on the account files and reports when they change. It also sets a login banner in /etc/issue.",
      "blocks": [
        {
          "blockId": "define-class",
          "label": "SSH server present",
          "params": {},
          "entries": [
            {
              "valueSourceId": "check-file-exists",
              "params": {
                "class_name": "sshd_installed",
                "path": "/etc/ssh/sshd_config"
              },
              "id": "813a852b-32d7-48c3-82d4-8866753304db"
            }
          ],
          "instanceId": "36ae4551-aad6-441f-a827-5611d8a15733",
          "groupId": "59e67646-2b46-46c8-a969-44eacf542efa"
        },
        {
          "blockId": "set-config-values",
          "label": "Harden SSH",
          "params": {
            "path": "/etc/ssh/sshd_config",
            "format": "space",
            "settings": "PermitRootLogin no\nMaxAuthTries 3\nX11Forwarding no"
          },
          "condition": {
            "mode": "if",
            "kind": "class",
            "className": "sshd_installed"
          },
          "instanceId": "1077e6e1-07f0-4223-8487-9a1eb950ef77",
          "groupId": "59e67646-2b46-46c8-a969-44eacf542efa"
        },
        {
          "blockId": "manage-service",
          "label": "Restart SSH on config change",
          "params": {
            "service_name": "ssh",
            "action": "restart"
          },
          "instanceId": "3f52406a-ef3f-4ab1-a01a-a70bf4b13ecc",
          "groupId": "59e67646-2b46-46c8-a969-44eacf542efa"
        },
        {
          "blockId": "set-permissions",
          "label": "Lock down account files",
          "params": {
            "path": "/etc/passwd\n/etc/group",
            "mode": "644",
            "owner": "root",
            "group": "root"
          },
          "instanceId": "dd49e047-4c4e-41d3-a4bd-f79a790b2bed",
          "groupId": "8f9ebcc8-2068-4ec2-abd0-27dc7158ef74"
        },
        {
          "blockId": "set-permissions",
          "label": "Protect password hashes",
          "params": {
            "path": "/etc/shadow",
            "mode": "640",
            "owner": "root",
            "group": "shadow"
          },
          "instanceId": "da52317b-5118-4abe-a77d-9fab9bdb2b29",
          "groupId": "8f9ebcc8-2068-4ec2-abd0-27dc7158ef74"
        },
        {
          "blockId": "watch-file",
          "label": "Watch account files",
          "params": {
            "path": "/etc/passwd\n/etc/group\n/etc/shadow"
          },
          "instanceId": "25cd5553-73db-4e75-a635-ce849956bfe6",
          "groupId": "8f9ebcc8-2068-4ec2-abd0-27dc7158ef74"
        },
        {
          "blockId": "report-message",
          "label": "Report account changes",
          "params": {
            "message": "Local accounts changed on $(sys.fqhost)"
          },
          "instanceId": "723803f4-7e5b-4fc5-b4bb-8963fabb8da4",
          "groupId": "8f9ebcc8-2068-4ec2-abd0-27dc7158ef74"
        },
        {
          "blockId": "ensure-lines",
          "label": "Login banner",
          "params": {
            "path": "/etc/issue",
            "lines": "Authorized access only. Activity may be monitored.",
            "create": "true"
          },
          "instanceId": "6b5a56af-cf96-4c4f-b2ae-171ddd389c38"
        }
      ],
