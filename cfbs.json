    {
      "name": "./common.cf",
      "description": "Local policy file added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": [
        "copy ./common.cf services/cfbs/common.cf",
        "policy_files services/cfbs/common.cf"
      ]
    },
    {
      "name": "./webserver.cf",
      "description": "Local policy file added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": [
        "copy ./webserver.cf services/cfbs/webserver.cf",
        "policy_files services/cfbs/webserver.cf",
        "bundles webserver"
      ]
    },
    {
      "name": "./templates/",
      "description": "Local subdirectory added using cfbs command line",
      "tags": ["local"],
      "added_by": "cfbs add",
      "steps": ["directory ./ services/cfbs/templates/"]
    }
  ],
