# Generated by CFEngine Policy Builder from "Webserver".
# Edits here are overwritten when the project is saved.
bundle agent webserver
{
  methods:
    "Install web server package"
      usebundle => webserver_install_web_server_package,
      if => "webserver_role",
      classes => results("bundle", "webserver_install_web_server_package");

    "Remove conflicting Apache"
      usebundle => webserver_remove_conflicting_apache,
      if => "webserver_role";

    "Render nginx config"
      usebundle => webserver_render_nginx_config,
      if => "webserver_install_web_server_package_kept|webserver_install_web_server_package_repaired",
      classes => results("bundle", "webserver_render_nginx_config");

    "Restart nginx on config change"
      usebundle => webserver_restart_nginx_on_config_change,
      if => "webserver_render_nginx_config_repaired";

    "Keep nginx running"
      usebundle => webserver_keep_nginx_running,
      if => "webserver_install_web_server_package_kept|webserver_install_web_server_package_repaired";

    "Publish the demo landing page"
      usebundle => webserver_publish_the_demo_landing_page,
      if => "webserver_install_web_server_package_kept|webserver_install_web_server_package_repaired";

    "Remove default nginx site"
      usebundle => webserver_remove_default_nginx_site;

    "Lock down nginx config files"
      usebundle => webserver_lock_down_nginx_config_files;

    "Create deploy user" usebundle => webserver_create_deploy_user;
    "Report provisioning done" usebundle => webserver_report_provisioning_done;
}

bundle agent webserver_install_web_server_package
{
  packages:
    "$(common_vars.webserver_package)" policy => "present";
}

bundle agent webserver_remove_conflicting_apache
{
  packages:
    "apache2" policy => "absent";
}

bundle agent webserver_render_nginx_config
{
  vars:
    "worker_processes" string => "$(common_vars.worker_processes)";
    "worker_connections" string => "$(common_vars.worker_connections)";

    "template_data"
      data => mergedata(
        '{ "vars": { "common_vars": { "worker_processes": worker_processes, "worker_connections": worker_connections } } }'
      );

  files:
    "/etc/nginx/nginx.conf"
      create => "true",
      edit_template => "$(this.promise_dirname)/templates/webserver_render_nginx_config.mustache",
      template_method => "mustache",
      perms => mog("644", "root", "root"),
      template_data => @(template_data);
}

bundle agent webserver_restart_nginx_on_config_change
{
  services:
    "nginx" service_policy => "restart";
}

bundle agent webserver_keep_nginx_running
{
  services:
    "nginx" service_policy => "start";
}

bundle agent webserver_publish_the_demo_landing_page
{
  vars:
    "fqhost" string => "$(sys.fqhost)";
    "flavor" string => "$(sys.flavor)";
    "worker_processes" string => "$(common_vars.worker_processes)";
    "cf_version" string => "$(sys.cf_version)";

    "template_data"
      data => mergedata(
        '{ "vars": { "sys": { "fqhost": fqhost, "flavor": flavor, "cf_version": cf_version }, "common_vars": { "worker_processes": worker_processes } } }',
        parsejson(
          format(
            '{ "classes": { "webserver_role": %s } }',
            ifelse("webserver_role", "true", "false")
          )
        )
      );

  files:
    "/var/www/html/index.html"
      create => "true",
      edit_template => "$(this.promise_dirname)/templates/webserver_publish_the_demo_landing_page.mustache",
      template_method => "mustache",
      perms => mog("644", "root", "root"),
      template_data => @(template_data);
}

bundle agent webserver_remove_default_nginx_site
{
  files:
    "/etc/nginx/sites-enabled/default"
      delete => tidy,
      pathtype => "literal";
}

bundle agent webserver_lock_down_nginx_config_files
{
  vars:
    "path"
      slist => { "/etc/nginx/nginx.conf", "/etc/nginx/conf.d/default.conf" };

  files:
    "$(path)" perms => mog_dirs("644", "root", "root");
}

bundle agent webserver_create_deploy_user
{
  users:
    "deploy" policy => "present";
}

bundle agent webserver_report_provisioning_done
{
  reports:
    "Web server provisioning complete";
}

body perms mog_dirs(mode, user, group)
{
  owners => { "$(user)" };
  groups => { "$(group)" };
  mode => "$(mode)";
  rxdirs => "true";
}
