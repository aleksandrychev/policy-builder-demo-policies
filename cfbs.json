{
  "name": "Nginx Web Server Demo",
  "description": "Policy built with CFEngine Policy Builder",
  "type": "policy-set",
  "git": true,
  "build": [
    {
      "name": "masterfiles",
      "description": "Official CFEngine Masterfiles Policy Framework (MPF).",
