    {
      "id": "e97e2eb0-6f27-45c6-b012-4e6b5c48360e",
      "name": "Common",
      "bundle": "common",
      "path": "./common.cf",
      "description": "Settings the other files share. It names the nginx package, sizes its workers from the CPU count, and caps connections per worker. It also defines the webserver_role class that marks a host as a web server.",
      "blocks": [
        {
          "blockId": "define-variable",
          "label": "Nginx settings",
          "params": {},
          "entries": [
            {
              "valueSourceId": "literal",
              "params": {
                "variable_name": "webserver_package",
                "value": "nginx"
              },
              "id": "e12ecab4-95c1-4b13-b85d-005e5dd70d45"
            },
            {
              "valueSourceId": "file-lines",
              "params": {
                "variable_name": "worker_processes",
                "path": "/proc/cpuinfo",
                "comment": "",
                "split": "\\n",
                "max_entries": "1000",
                "max_bytes": "1048576"
              },
              "sampleInput": "processor\t: 0\nmodel name\t: Example CPU\nprocessor\t: 1\nmodel name\t: Example CPU",
              "decorators": [
                {
                  "id": "fec25917-982d-4658-b265-119808ad93ff",
                  "decoratorId": "grep",
                  "params": {
                    "pattern": "processor.*"
                  }
                },
                {
                  "id": "b2bd058e-ab34-4e31-95f2-05e4b229872d",
